<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50 text-slate-900">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}UX Native Scanner{% endblock %}</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
          tailwind.config = {
            theme: {
              extend: {
                colors: {
                  border: 'hsl(214.3 31.8% 91.4%)',
                  input: 'hsl(214.3 31.8% 91.4%)',
                  ring: 'hsl(222.2 84% 4.9%)',
                  background: 'hsl(0 0% 100%)',
                  foreground: 'hsl(222.2 84% 4.9%)',
                  primary: {
                    DEFAULT: 'hsl(222.2 47.4% 11.2%)',
                    foreground: 'hsl(210 40% 98%)',
                  },
                  secondary: {
                    DEFAULT: 'hsl(210 40% 96.1%)',
                    foreground: 'hsl(222.2 47.4% 11.2%)',
                  },
                  destructive: {
                    DEFAULT: 'hsl(0 84.2% 60.2%)',
                    foreground: 'hsl(210 40% 98%)',
                  },
                  muted: {
                    DEFAULT: 'hsl(210 40% 96.1%)',
                    foreground: 'hsl(215.4 16.3% 46.9%)',
                  },
                  card: {
                    DEFAULT: 'hsl(0 0% 100%)',
                    foreground: 'hsl(222.2 84% 4.9%)',
                  },
                }
              }
            }
          }
        </script>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-full flex flex-col font-sans antialiased">
        <header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/95 backdrop-blur">
            <div class="container max-w-5xl mx-auto flex h-16 items-center justify-between px-4 sm:px-6">
                <a href="{{ path('app_scan') }}" class="flex items-center gap-2 font-bold text-lg text-slate-900">
                    <span class="text-2xl">🎴</span> UX Native Scanner
                </a>
                <nav class="flex items-center space-x-2">
                    <a href="{{ path('app_scan') }}">
                        {% component 'Button' with {variant: 'default', size: 'sm'} %}
                            {% block content %}📷 Scanner{% endblock %}
                        {% endcomponent %}
                    </a>
                    <a href="{{ path('app_contact_index') }}">
                        {% component 'Button' with {variant: 'ghost', size: 'sm'} %}
                            {% block content %}Contacts{% endblock %}
                        {% endcomponent %}
                    </a>
                    <a href="{{ path('app_event_index') }}">
                        {% component 'Button' with {variant: 'ghost', size: 'sm'} %}
                            {% block content %}Évènements{% endblock %}
                        {% endcomponent %}
                    </a>
                </nav>
            </div>
        </header>

        <main class="container max-w-5xl mx-auto px-4 sm:px-6 py-8 flex-1">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-6 p-4 rounded-md border {% if label == 'danger' %}border-red-200 bg-red-50 text-red-800{% else %}border-emerald-200 bg-emerald-50 text-emerald-800{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
