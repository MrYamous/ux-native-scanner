{# Header component using plain HTML #}
<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="container max-w-5xl mx-auto flex h-16 items-center justify-between px-4 sm:px-6">
        <a href="{{ path('app_scan') }}" class="flex items-center gap-2 font-bold text-lg text-slate-900">
            <span class="text-2xl">🎴</span> UX Native Scanner
        </a>
        <nav class="flex items-center space-x-2">
            <a href="{{ path('app_scan') }}">
                {% component 'Button' with {variant: 'default', size: 'sm'} %}
                    {% block content %}📷 Scanner{% endblock %}
                {% endcomponent %}
            </a>
            <a href="{{ path('app_contact_index') }}">
                {% component 'Button' with {variant: 'ghost', size: 'sm'} %}
                    {% block content %}Contacts{% endblock %}
                {% endcomponent %}
            </a>
            <a href="{{ path('app_event_index') }}">
                {% component 'Button' with {variant: 'ghost', size: 'sm'} %}
                    {% block content %}Évènements{% endblock %}
                {% endcomponent %}
            </a>
        </nav>
    </div>
</header>
