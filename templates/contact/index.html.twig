{% extends 'base.html.twig' %}

{% block title %}Liste des Contacts{% endblock %}

{% block body %}
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Contacts</h1>
        <p class="text-sm text-slate-500">{{ contacts|length }} contact(s) enregistré(s)</p>
    </div>
    <div class="flex gap-2">
        <a href="{{ path('app_scan') }}">
            {% component 'Button' with {variant: 'outline', size: 'sm'} %}
                {% block content %}📷 Scanner{% endblock %}
            {% endcomponent %}
        </a>
    </div>
</div>

{% component 'Card' %}
    {% block content %}
        {% component 'Card:Content' with {class: 'p-0'} %}
            {% block content %}
                {% if contacts is empty %}
                    <div class="p-8 text-center text-slate-500">
                        Aucun contact enregistré pour le moment.
                    </div>
                {% else %}
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left text-slate-600">
                            <thead class="text-xs uppercase bg-slate-50 text-slate-500 border-b border-slate-200">
                                <tr>
                                    <th class="px-6 py-3">Nom / Prénom</th>
                                    <th class="px-6 py-3">Entreprise / Poste</th>
                                    <th class="px-6 py-3">Coordonnées</th>
                                    <th class="px-6 py-3">Évènements</th>
                                    <th class="px-6 py-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                {% for contact in contacts %}
                                    <tr class="hover:bg-slate-50/50">
                                        <td class="px-6 py-4 font-medium text-slate-900">
                                            <a href="{{ path('app_contact_show', {'id': contact.id}) }}" class="hover:underline">
                                                {{ contact.firstname }} {{ contact.lastname }}
                                            </a>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div>{{ contact.company ?: '-' }}</div>
                                            {% if contact.jobTitle %}<div class="text-xs text-slate-400">{{ contact.jobTitle }}</div>{% endif %}
                                        </td>
                                        <td class="px-6 py-4">
                                            {% if contact.email %}<div class="text-xs text-slate-700">{{ contact.email }}</div>{% endif %}
                                            {% if contact.phone %}<div class="text-xs text-slate-400">{{ contact.phone }}</div>{% endif %}
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex flex-wrap gap-1">
                                                {% for event in contact.events %}
                                                    {% component 'Badge' with {variant: 'secondary'} %}
                                                        {% block content %}{{ event.name }}{% endblock %}
                                                    {% endcomponent %}
                                                {% else %}
                                                    <span class="text-xs text-slate-400 font-italic">Aucun</span>
                                                {% endfor %}
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-right space-x-2">
                                            <a href="{{ path('app_contact_show', {'id': contact.id}) }}" class="text-xs font-medium text-slate-600 hover:text-slate-900">Voir</a>
                                            <a href="{{ path('app_contact_edit', {'id': contact.id}) }}" class="text-xs font-medium text-slate-600 hover:text-slate-900">Éditer</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            {% endblock %}
        {% endcomponent %}
    {% endblock %}
{% endcomponent %}
{% endblock %}
