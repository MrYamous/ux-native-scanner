{% extends 'base.html.twig' %}

{% block title %}Nouveau Contact{% endblock %}

{% block body %}
<article>
    <header>
        <h2>Nouveau Contact</h2>
    </header>

{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    {{ form_widget(form) }}
    <button type="submit" class="w-full py-2.5 text-base bg-primary text-primary-foreground rounded-md">Créer</button>
{{ form_end(form) }}
</article>
{% endblock %}
