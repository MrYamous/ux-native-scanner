{% extends 'base.html.twig' %}

{% block title %}Éditer le Contact{% endblock %}

{% block body %}
<article>
    <header>
        <h2 class="text-4xl font-bold mb-4">Éditer le Contact</h2>
    </header>

{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            {{ form_label(form.firstname, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-2'}}) }}
            {{ form_widget(form.firstname, {'attr': {'class': 'block w-full text-sm text-slate-500 border border-slate-200 rounded-md p-2'}}) }}
            {{ form_errors(form.firstname) }}
        </div>
        <div>
            {{ form_label(form.lastname, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-2'}}) }}
            {{ form_widget(form.lastname, {'attr': {'class': 'block w-full text-sm text-slate-500 border border-slate-200 rounded-md p-2'}}) }}
            {{ form_errors(form.lastname) }}
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-2'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'block w-full text-sm text-slate-500 border border-slate-200 rounded-md p-2'}}) }}
            {{ form_errors(form.email) }}
        </div>
        <div>
            {{ form_label(form.phone, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-2'}}) }}
            {{ form_widget(form.phone, {'attr': {'class': 'block w-full text-sm text-slate-500 border border-slate-200 rounded-md p-2'}}) }}
            {{ form_errors(form.phone) }}
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            {{ form_label(form.company, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-2'}}) }}
            {{ form_widget(form.company, {'attr': {'class': 'block w-full text-sm text-slate-500 border border-slate-200 rounded-md p-2'}}) }}
            {{ form_errors(form.company) }}
        </div>
        <div>
            {{ form_label(form.type, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-2'}}) }}
            {{ form_widget(form.type, {'attr': {'class': 'block w-full text-sm text-slate-500 border border-slate-200 rounded-md p-2'}}) }}
            {{ form_errors(form.type) }}
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            {{ form_label(form.website, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-2'}}) }}
            {{ form_widget(form.website, {'attr': {'class': 'block w-full text-sm text-slate-500 border border-slate-200 rounded-md p-2'}}) }}
            {{ form_errors(form.website) }}
        </div>
        <div>
            {{ form_label(form.address, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-2'}}) }}
            {{ form_widget(form.address, {'attr': {'class': 'block w-full text-sm text-slate-500 border border-slate-200 rounded-md p-2', 'rows': 2}}) }}
            {{ form_errors(form.address) }}
        </div>
    </div>
    <div class="mt-4">
        {{ form_label(form.city, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-2'}}) }}
        {{ form_widget(form.city, {'attr': {'class': 'block w-full text-sm text-slate-500 border border-slate-200 rounded-md p-2'}}) }}
        {{ form_errors(form.city) }}
    </div>
    <div>
        {{ form_label(form.notes, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-2'}}) }}
        {{ form_widget(form.notes, {'attr': {'class': 'block w-full text-sm text-slate-500 border border-slate-200 rounded-md p-2', 'rows': 3}}) }}
        {{ form_errors(form.notes) }}
    </div>
    <div>
        {{ form_label(form.events, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-2'}}) }}
        {{ form_widget(form.events, {'attr': {'class': 'w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-400'}}) }}
        {{ form_errors(form.events) }}
    </div>
    {% component 'Button' with {type: 'submit', class: 'w-full py-2.5 text-base'} %}
        {% block content %}Enregistrer{% endblock %}
    {% endcomponent %}
{{ form_end(form) }}

</article>
{% endblock %}
